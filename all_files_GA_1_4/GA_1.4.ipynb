    "### YOUR CODE HERE\n",
    "# Empirical CDF\n",
    "y_h, x_h = ecdf(h)\n",
    "y_q, x_q = ecdf(q)\n",
    "\n",
    "# Empirical exceedance probabilities\n",
    "exc_h = 1 - y_h\n",
    "exc_q = 1 - y_q\n",
    "\n",
    "# Fitted exceedance probabilities\n",
    "fit_exc_h = 1 - stats.lognorm.cdf(x_h, *params_h)\n",
    "fit_exc_q = 1 - stats.gumbel_r.cdf(x_q, *params_q)\n",
    "\n",
    "# Plot\n",
    "fig, ax = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "# h\n",
    "ax[0].semilogy(x_h, exc_h, label='Empirical')\n",
    "ax[0].semilogy(x_h, fit_exc_h, label='Lognormal')\n",
    "ax[0].set_xlabel('Water depth h [m]')\n",
    "ax[0].set_ylabel('Exceedance probability')\n",
    "ax[0].set_title('Goodness of fit for h')\n",
    "ax[0].legend()\n",
    "ax[0].grid(True)\n",
    "\n",
    "# q\n",
    "ax[1].semilogy(x_q, exc_q, label='Empirical')\n",
    "ax[1].semilogy(x_q, fit_exc_q, label='Gumbel')\n",
    "ax[1].set_xlabel('Discharge q [m³/s]')\n",
    "ax[1].set_ylabel('Exceedance probability')\n",
    "ax[1].set_title('Goodness of fit for q')\n",
    "ax[1].legend()\n",
    "ax[1].grid(True)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
