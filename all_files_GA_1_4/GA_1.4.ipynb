    "# -------------------------------\n",
    "# Task 5 - Monte Carlo propagation\n",
    "# -------------------------------\n",
    "\n",
    "# 1. Draw 10,000 independent samples\n",
    "N = 10000\n",
    "\n",
    "rs_h = stats.lognorm.rvs(*params_h, size=N, random_state=1)\n",
    "rs_q = stats.gumbel_r.rvs(*params_q, size=N, random_state=2)\n",
    "\n",
    "# 2. Compute simulated velocities\n",
    "rs_u = rs_q / (95 * rs_h)\n",
    "\n",
    "# 3. Compute observed velocities\n",
    "u = q / (95 * h)\n",
    "\n",
    "# 4a. Density-normalized histograms\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.hist(u, bins=30, density=True, alpha=0.5,\n",
    "         label='Observed')\n",
    "plt.hist(rs_u, bins=30, density=True, alpha=0.5,\n",
    "         label='Simulated')\n",
    "\n",
    "plt.xlabel('Flow velocity u [m/s]')\n",
    "plt.ylabel('Density')\n",
    "plt.title('Observed vs simulated velocity')\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# 4b. Exceedance plots\n",
    "\n",
    "# Calculate empirical CDFs\n",
    "y_obs, x_obs = ecdf(u)\n",
    "y_sim, x_sim = ecdf(rs_u)\n",
    "\n",
    "# Convert CDF to exceedance probability\n",
    "exc_obs = 1 - y_obs\n",
    "exc_sim = 1 - y_sim\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.semilogy(x_obs, exc_obs, label='Observed')\n",
    "plt.semilogy(x_sim, exc_sim, label='Simulated')\n",
    "\n",
    "plt.xlabel('Flow velocity u [m/s]')\n",
    "plt.ylabel('Exceedance probability')\n",
    "plt.title('Observed vs simulated velocity - Exceedance')\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# 5. Mean and standard deviation\n",
    "\n",
    "print(\"Observed velocity:\")\n",
    "print(\"Mean =\", np.mean(u))\n",
    "print(\"Standard deviation =\", np.std(u, ddof=1))\n",
    "\n",
    "print(\"\\nSimulated velocity:\")\n",
    "print(\"Mean =\", np.mean(rs_u))\n",
    "print(\"Standard deviation =\", np.std(rs_u, ddof=1))\n",
    "\n"
   ]
  },
