    "# WORKED EXAMPLE -- illustrates the mechanic only\n",
    "example_counts = pd.crosstab(\n",
    "    survey['programme'],\n",
    "    survey['cats_or_dogs'],\n",
    "    margins=True\n",
    ")\n",
    "example_counts\n"
