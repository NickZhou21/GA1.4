   "source": [
    "# -------------------------------\n",
    "# Task 6 - Scatter plot and correlation\n",
    "# -------------------------------\n",
    "\n",
    "# Pearson correlation coefficients\n",
    "rho_obs = stats.pearsonr(h, q)[0]\n",
    "rho_sim = stats.pearsonr(rs_h, rs_q)[0]\n",
    "\n",
    "print(\"Pearson correlation observed =\", rho_obs)\n",
    "print(\"Pearson correlation simulated =\", rho_sim)\n",
    "\n",
    "# Scatter plots\n",
    "fig, ax = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "# Paired observations\n",
    "ax[0].scatter(h, q, alpha=0.5)\n",
    "ax[0].set_xlabel('Water depth h [m]')\n",
    "ax[0].set_ylabel('Discharge q [m³/s]')\n",
    "ax[0].set_title('Observed h vs q')\n",
    "ax[0].grid()\n",
    "\n",
    "# Independent simulations\n",
    "ax[1].scatter(rs_h, rs_q, alpha=0.3)\n",
    "ax[1].set_xlabel('Water depth h [m]')\n",
    "ax[1].set_ylabel('Discharge q [m³/s]')\n",
    "ax[1].set_title('Independent simulated h vs q')\n",
    "ax[1].grid()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
